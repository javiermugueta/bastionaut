    "«El Bastion no tiene activado SOCKS5»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The bastion doesn’t have SOCKS5 enabled”"
          }
        }
      }
    },
    "«El puerto local está ocupado»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The local port is in use”"
          }
        }
      }
    },
    "«No consigo conectar con el Bastion por SSH»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I can’t reach the bastion over SSH”"
          }
        }
      }
    },
    "«OCI respondió 401»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“OCI returned 401”"
          }
        }
      }
    },
    "«OCI respondió 404 NotAuthorizedOrNotFound»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“OCI returned 404 NotAuthorizedOrNotFound”"
          }
        }
      }
    },
    "«SSH rechazó la clave» en el servidor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“SSH rejected the key” on the server"
          }
        }
      }
    },
    "¿Cómo entramos? 🔑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do we get in? 🔑"
          }
        }
      }
    },
    "¿Eliminar «%@»?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        }
      }
    },
    "¿Está permitida mi IP? 🌐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my IP allowed? 🌐"
          }
        }
      }
    },
    "¿No aparece? Búscalo en un compartimento o pega su OCID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not listed? Look in a compartment or paste its OCID"
          }
        }
      }
    },
    "¿No tienes configuración? Créala con `oci setup config` o desde la consola de OCI › Perfil › Claves de API › Añadir clave de API.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No configuration yet? Create one with `oci setup config` or from the OCI console › Profile › API keys › Add API key."
          }
        }
      }
    },
    "¿Qué pasa? 📖": {
      "localizations": {
