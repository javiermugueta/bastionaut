    "Bastionaut abre túneles hacia tus máquinas privadas de Oracle Cloud a través del servicio **Bastion**, sin que tengas que escribir comandos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bastionaut opens tunnels to your private Oracle Cloud machines through the **Bastion** service, without you having to type commands."
          }
        }
      }
    },
