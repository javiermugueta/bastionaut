    },
    "En modo reenvío de puerto, el icono de cada servidor o túnel se pone verde cuando su sesión está activa, y el botón ■ la cierra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In port forwarding mode, each server or tunnel icon turns green while its session is active, and the ■ button closes it."
          }
        }
      }
    },
