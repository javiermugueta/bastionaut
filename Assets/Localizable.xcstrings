          "stringUnit": {
            "state": "translated",
            "value": "The remote port is missing."
          }
        }
      }
    },
    "Falta la IP del servidor SSH (o desmarca «Pasar por un servidor SSH»).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH server IP is missing (or turn off “Go through an SSH server”)."
          }
        }
      }
    },
    "Falta la clave privada del servidor SSH.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH server private key is missing."
          }
        }
      }
    },
    "Faltan la IP y el usuario del servidor.": {
      "localizations": {
        "en": {
          "stringUnit": {
