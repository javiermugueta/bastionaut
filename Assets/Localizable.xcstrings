    "Renovar %lld min antes de caducar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renew %lld min before it expires"
          }
        }
      }
    },
    "Renuevo la sesión antes de que caduque para que no se te corte nada.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I renew the session before it expires so nothing gets cut off."
