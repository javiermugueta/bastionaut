    "OCI Bastion": {
      "shouldTranslate": false
    },
    "OCI Bastion abre túneles hacia tus máquinas privadas de Oracle Cloud a través del servicio **Bastion**, sin que tengas que escribir comandos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OCI Bastion opens tunnels to your private Oracle Cloud machines through the **Bastion** service, without you having to type commands."
          }
        }
      }
    },
    "OCID del Bastion": {
      "localizations": {
        "en": {
          "stringUnit": {
