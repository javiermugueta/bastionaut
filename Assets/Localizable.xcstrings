    "Hablando con OCI para comprobar tu cuenta… 🔌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talking to OCI to check your account… 🔌"
          }
        }
      }
    },
    "Hablo directamente con la API de OCI con tu clave de API, que guardo en el Llavero. No hace falta el OCI CLI.": {
      "localizations": {
        "en": {
          "stringUnit": {
